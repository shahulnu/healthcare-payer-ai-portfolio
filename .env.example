# Leave empty to run the demo in replay mode (recorded sample outputs, no API calls).
ANTHROPIC_API_KEY=

# Optional: cap live evaluations per visitor IP per day (default 10).
PA_DAILY_LIMIT_PER_IP=10

# Optional: run the demos on the Java services (healthcare-payer-ai-services project) instead of the built-in
# TypeScript engines. Leave empty to use TypeScript.
PA_ENGINE_URL=
APPEALS_ENGINE_URL=
BENEFITS_ENGINE_URL=
PI_ENGINE_URL=
HCC_ENGINE_URL=
